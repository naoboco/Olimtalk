{
  "name": "olimtalk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OlimTalk — the open messaging platform for olim: public groups, communities, stories and an integration guide, in four language worlds.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist/server.js",
    "start": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test server/test/*.test.ts shared/*.test.ts web/src/lib/*.test.tsx web/src/lib/*.test.ts",
    "build:app": "OLIMTALK_TARGET=app vite build --config web/vite.config.ts && cap sync",
    "android": "cap open android",
    "ios": "cap open ios"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naoboco/Olimtalk.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.6.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "better-sqlite3": "^13.2.0",
    "compression": "^1.8.2",
    "cookie": "^2.0.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ical.js": "^2.2.1",
    "mailparser": "^3.15.0",
    "multer": "^2.5.0",
    "nanoid": "^6.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "smtp-server": "^3.21.7",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.11",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "nodemailer": "^10.6.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
