# Port du serveur (API + application web)
PORT=3000

# Dossier persistant : base SQLite (olimtalk.db) et fichiers envoyés (uploads/)
DATA_DIR=./data

# Adresse publique du site, utilisée dans les aperçus de liens (WhatsApp, Facebook…)
# PUBLIC_URL=https://olimtalk.example

# E-mails (séparés par des virgules) des comptes qui deviennent modérateurs de la plateforme
# ADMIN_EMAILS=vous@example.com

# Taille maximale d'un fichier envoyé, en Mo
# MAX_UPLOAD_MB=25

# Pages légales (/privacy et /terms) : nom de l'exploitant et adresse de contact
# LEGAL_OPERATOR=Votre association ou société
# LEGAL_CONTACT=contact@olimtalk.example

# Liens des stores, affichés sur le site une fois les applications publiées
# APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXXX
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.olimtalk.app

# Traduction automatique : les messages publics s'affichent dans la langue de chaque lecteur.
# Avec Claude, la clé suffit. Sans aucun réglage ici, la traduction est désactivée sur le
# serveur (chacun peut alors utiliser sa propre IA).
# ANTHROPIC_API_KEY=
# Modèle : claude-opus-5-5 par défaut ; claude-haiku-5-5 est nettement moins cher pour un tel volume.
# TRANSLATE_MODEL=claude-haiku-5-5
# Ou tout service compatible « chat completions » : OpenAI, Mistral, un modèle hébergé chez vous…
# TRANSLATE_PROVIDER=openai-compatible
# TRANSLATE_BASE_URL=https://…/v1
# TRANSLATE_API_KEY=
# TRANSLATE_MODEL=
# Nombre maximal de nouvelles traductions par personne et par heure (chacune vous est facturée)
# TRANSLATE_HOURLY_LIMIT=600
# Pour couper la traduction même si une clé est présente
# TRANSLATE_PROVIDER=off

# Boîte mail : domaine des adresses de transfert privées (ex. in.votre-domaine).
# Sans cette variable, la fonction « Ma boîte mail » est masquée.
# MAIL_DOMAIN=in.olimtalk.example
# Réception directe (serveur pouvant ouvrir un port SMTP, enregistrement MX vers ce serveur)
# SMTP_PORT=25
# Certificat TLS de ce serveur de réception (chemins de fichiers), recommandé en production
# SMTP_TLS_KEY=/etc/ssl/private/mail.key
# SMTP_TLS_CERT=/etc/ssl/certs/mail.pem
# Ou réception par un service d'e-mail qui poste le message brut sur /api/inbound/email?to=…
# avec l'en-tête X-Inbound-Secret
# INBOUND_MAIL_SECRET=une-longue-chaine-aleatoire

# IA : autres adresses que le site peut contacter directement (fournisseur compatible OpenAI…)
# CSP_CONNECT_EXTRA=https://api.exemple.com

# Origines autorisées pour les applications mobiles (valeurs par défaut de Capacitor)
# CORS_ORIGINS=capacitor://localhost,https://localhost

# Mettre à 0 si le serveur est exposé directement, sans proxy inverse devant lui
# TRUST_PROXY=1
