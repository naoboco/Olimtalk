# Port du serveur (API + application web)
PORT=3000

# Dossier persistant : base SQLite (olimtalk.db) et fichiers envoyés (uploads/)
DATA_DIR=./data

# Adresse publique du site, utilisée dans les aperçus de liens (WhatsApp, Facebook…)
# PUBLIC_URL=https://olimtalk.example

# E-mails (séparés par des virgules) des comptes qui deviennent modérateurs de la plateforme
# ADMIN_EMAILS=vous@example.com

# Taille maximale d'un fichier envoyé, en Mo
# MAX_UPLOAD_MB=25

# Mettre à 0 si le serveur est exposé directement, sans proxy inverse devant lui
# TRUST_PROXY=1
